# LM Studio (OpenAI-compatible) — ผู้ช่วยร่างแผนการพยาบาล
# ต้องเปิด local server จากแท็บ Developer ใน LM Studio ก่อน (พอร์ตปกติคือ 1234)
# ชื่อโมเดลต้องตรงกับที่โหลดไว้ ตรวจได้จาก GET {LM_STUDIO_URL}/models
# โมเดลที่คิดก่อนตอบ (reasoning) ใช้เวลาราวหนึ่งนาทีต่อคำขอ ตั้ง timeout ให้เผื่อ
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_TIMEOUT_MS=180000
