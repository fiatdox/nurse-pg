# HIS MariaDB Database configuration
HIS_HOST=
HIS_PORT=3306
HIS_USER=
HIS_PASSWORD=
HIS_NAME=

# Secret key for JWT signing
JWT_SECRET=

# พอร์ตของ API (ไม่ตั้ง = 4001)
PORT=4001

# origin ของหน้าเว็บ frontend (พอร์ต 4002)
CORS_ORIGINS=http://localhost:4002


#CoreKon Auth PG DB Configuration
CORE_KON_HOST=
CORE_KON_PORT=5432
CORE_KON_USER=
CORE_KON_PASSWORD=
CORE_KON_DB_NAME=
CORE_KON_SCHEMA=core_kon

#Nurse  PG DB Configuration
NURSE_PG_HOST=
NURSE_PG_PORT=5432
NURSE_PG_USER=
NURSE_PG_PASSWORD=
NURSE_PG_DB_NAME=
NURSE_PG_SCHEMA=public

# LM Studio (OpenAI-compatible) — ผู้ช่วยร่างแผนการพยาบาล
# ต้องเปิด local server จากแท็บ Developer ใน LM Studio ก่อน (พอร์ตปกติคือ 1234)
# ชื่อโมเดลต้องตรงกับที่โหลดไว้ ตรวจได้จาก GET {LM_STUDIO_URL}/models
# โมเดลที่คิดก่อนตอบ (reasoning) ใช้เวลาราวหนึ่งนาทีต่อคำขอ ตั้ง timeout ให้เผื่อ
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_TIMEOUT_MS=180000

# ใบสั่งยาจากหอผู้ป่วย
# โฟลเดอร์เก็บไฟล์สแกน ควรเป็นดิสก์ที่มีการสำรองข้อมูล (ไม่ตั้ง = uploads/rx ในโฟลเดอร์โปรแกรม)
RX_UPLOAD_DIR=
# เก็บไฟล์ภาพใบสั่งยากี่วัน ครบแล้วลบออกจากดิสก์อัตโนมัติ (ข้อมูลใบและประวัติไม่ถูกลบ)
# จำนวนเต็ม 30-3650 · ไม่ตั้งหรือค่าผิด = 120 · เปลี่ยนแล้วต้อง restart เซิร์ฟเวอร์
RX_FILE_RETENTION_DAYS=120

# ── บัญชีบริษัทผู้รับจ้าง (vendor) ──
# กุญแจเข้ารหัสเลขบัตรประชาชนและ OTP — base64 ยาว 32 ไบต์
# สร้างด้วย: openssl rand -base64 32  (แต่ละเครื่องใช้กุญแจของตัวเอง ห้าม commit)
# ไม่ตั้ง = บริษัทเข้าระบบไม่ได้ · ทำกุญแจหาย = อ่านเลขบัตรเดิมไม่ได้ ต้องกรอกเลขบัตรของทุกบัญชีใหม่
VENDOR_PII_KEY=
# ช่องทางส่ง OTP: mophprompt (ค่าเริ่มต้น, LINE OA หมอพร้อม) หรือ console (พิมพ์ลง log — เครื่อง dev เท่านั้น)
VENDOR_OTP_TRANSPORT=
# client ID / secret ที่ได้จากหมอพร้อม สำหรับส่ง OTP — ห้าม commit
MOPHPROMPT_CLIENT_ID=
MOPHPROMPT_CLIENT_SECRET=
